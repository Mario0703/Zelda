use crate::ast::Integer;
use crate::lexer::tokens::{LexingError, Token};

grammar;

extern {
    type Location = usize;
    type Error = LexingError;

    enum Token {
        INTEGER => Token::Integer(<i64>),
    }
}

// for now, the whole language is: a single integer literal
pub Program: Integer = INTEGER => Integer::Int(<>);